# Docker environment template.
# Copy to .env at the repo root and fill in real values:
#   cp .env.docker.example .env
# (.env is gitignored and read by both docker-compose files.)

# ─── Database ────────────────────────────────────────────────────────────────
# Development (docker-compose.yml)
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=inspiration_store_development

# Production (docker-compose.prod.yml)
SERVER_DATABASE_PASSWORD=change_me_strong_password

# ─── Rails ───────────────────────────────────────────────────────────────────
# JWT signing key (min 32 chars). Generate: openssl rand -hex 32
DEVISE_JWT_SECRET_KEY=change_me_min_32_chars_secret

# Required ONLY for production to decrypt credentials.yml.enc.
# Value lives in server/config/master.key (do not commit it).
RAILS_MASTER_KEY=

# ─── URLs / CORS ─────────────────────────────────────────────────────────────
# Public frontend origin allowed by the API (prod). Comma-separate multiple.
CORS_ORIGINS=http://localhost
# URL the browser uses to reach the API; baked into the frontend prod build.
VITE_API_URL=http://localhost:3000

# ─── Wompi (payments) ────────────────────────────────────────────────────────
# Use WOMPI_FAKE_MODE=true for local dev without real keys.
WOMPI_FAKE_MODE=true
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_KEY=
WOMPI_EVENT_SECRET=
WOMPI_CURRENCY=COP
WOMPI_FAKE_PUBLIC_KEY=pk_test_stub
WOMPI_FAKE_INTEGRITY_KEY=fake_integrity_key

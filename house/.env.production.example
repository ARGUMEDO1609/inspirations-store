# ═══════════════════════════════════════════════════════════════════
# Inspiration Store — Frontend Environment Variables
# ═══════════════════════════════════════════════════════════════════
#
# Para Vercel: pegalo en Settings → Environment Variables
# Para deploy manual: creá house/.env.production
# ═══════════════════════════════════════════════════════════════════

# ─── API Backend ────────────────────────────────────────────────
VITE_API_URL=https://api.TU-DOMINIO.com

# ─── Action Cable (WebSocket) ──────────────────────────────────
VITE_CABLE_URL=wss://api.TU-DOMINIO.com/cable

# ─── Sentry Error Tracking (frontend) ──────────────────────────
# Creá un segundo proyecto en sentry.io para el frontend
VITE_SENTRY_DSN=

{
  "version": 2,
  "builds": [
    {
      "src": "house/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist",
        "framework": "vite"
      }
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/house/dist/assets/$1"
    },
    {
      "src": "/(.*\\.(js|css|png|jpg|svg|ico|woff|woff2|ttf|eot))$",
      "dest": "/house/dist/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/house/dist/index.html"
    }
  ]
}

# ═══════════════════════════════════════════════════════════════════
# Inspiration Store — Production Environment Variables
# ═══════════════════════════════════════════════════════════════════
#
# Genera secretos con:
#   openssl rand -hex 24   → DATABASE_PASSWORD
#   openssl rand -hex 64   → DEVISE_JWT_SECRET_KEY
#   openssl rand -hex 32   → WOMPI secrets
#
# NUNCA subas este archivo a git. En Railway/Render, pegalo en
# la sección de Environment Variables del dashboard.
# ═══════════════════════════════════════════════════════════════════

# ─── Base de datos ───────────────────────────────────────────────
# Railway provee DATABASE_URL automáticamente.
# Si usás Render, copia el Internal Database URL.
DATABASE_URL=postgresql://user:password@host:5432/inspiration_store_production

# ─── Seguridad ──────────────────────────────────────────────────
DEVISE_JWT_SECRET_KEY=GENERATE_WITH_openssl_rand_hex_64

# ─── Wompi (credenciales de PRODUCCIÓN) ─────────────────────────
# pedilas a Wompi o sacalas de tu dashboard de Wompi
WOMPI_PUBLIC_KEY=pub_prod_TU_CLAVE_PUBLICA
WOMPI_INTEGRITY_KEY=prod_integrity_TU_CLAVE_INTEGRIDAD
WOMPI_EVENT_SECRET=prod_events_TU_CLAVE_EVENTOS
WOMPI_CURRENCY=COP
WOMPI_FAKE_MODE=false

# ─── URLs ───────────────────────────────────────────────────────
# Tu dominio de producción (ej: inspiration-store.vercel.app)
FRONTEND_URL=https://TU-DOMINIO-FRONTEND.vercel.app
APP_HOST=api.TU-DOMINIO.com
CORS_ORIGINS=https://TU-DOMINIO-FRONTEND.vercel.app

# ─── Action Cable ───────────────────────────────────────────────
CABLE_URL=wss://api.TU-DOMINIO.com/cable

# ─── Sentry Error Tracking ──────────────────────────────────────
# Creá un proyecto en sentry.io y copiá el DSN aquí
SENTRY_DSN=

# ─── Active Storage (CDN) ───────────────────────────────────────
# Opcional: si no configurás esto, las imágenes se sirven desde
# el servidor (funciona para tráfico bajo, pero no es ideal).
# Configurar un bucket S3 + CloudFront después del primer deploy.
# AWS_S3_BUCKET_NAME=tu-bucket-inspiration
# AWS_ACCESS_KEY_ID=tu-access-key
# AWS_SECRET_ACCESS_KEY=tu-secret-key
# AWS_REGION=us-east-1

# ─── SMTP (opcional) ───────────────────────────────────────────
# Solo si querés enviar emails de confirmación de pedido
# SMTP_ADDRESS=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER_NAME=tu-email@gmail.com
# SMTP_PASSWORD=tu-app-password

# ─── Redis (opcional) ──────────────────────────────────────────
# Solo si necesitás cache compartido entre múltiples instancias
# REDIS_URL=redis://default:password@host:6379/1

# ─── Rails Config ───────────────────────────────────────────────
RAILS_LOG_LEVEL=info
RAILS_ENV=production

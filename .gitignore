# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong to git's global ignore instead:
#   `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Environment files - never commit real secrets. Keep only the templates.
.env*
!.env.example

# Logs and temp files.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Uploaded files / local storage.
/storage/*
!/storage/.keep

# Build assets.
/public/assets
server/app/assets/builds

# Key files for decrypting Rails credentials - never commit.
/config/*.key
/config/credentials.yml.enc

# Same for subdirectories (server/ config dir too).
server/config/*.key
server/config/credentials.yml.enc

# AI assistant / tooling files (do not publish to GitHub).
CLAUDE.md
**/CLAUDE.md
AGENTS.md
**/AGENTS.md
.claude/
**/.claude/
.grok/
**/.grok/
.cursor/
**/.cursor/
.cursorrules
.aider*
.github/copilot-instructions.md
.continue/
.windsurfrules
.codeium/

# Local deliverables / generated docs (not part of the codebase).
/Sistema-de-Seeds-Inspiration-Store.pdf
